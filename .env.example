# Copy to .env and set API_KEY. Everything else already has a working default in
# docker-compose.yml, so this file is optional apart from the token:
#
#   echo 'API_KEY=123456:your-token-from-BotFather' > .env && docker compose up -d

# --- Required -------------------------------------------------------------
# Your Telegram bot token from @BotFather. Nothing can default this.
API_KEY=123456:your-telegram-bot-token-from-BotFather

# --- Optional: override only if a default clashes -------------------------
# Object storage credentials (CloudServer). Containers reach it at minio:8000;
# from the host it is localhost:9000.
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin123
#MINIO_BUCKET=media

#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DB=aerosearch

# Host ports, in case something already owns these.
#MINIO_PORT=9000
#POSTGRES_PORT=5432
#AIRFLOW_PORT=8080

# Retrieval server + upload site port.
#AEROSEARCH_PORT=8000

# --- Indexing on the Kaggle GPU pool -------------------------------------
# The notebook runs on a T4 and must reach THIS machine; it cannot use
# localhost. Expose Postgres and S3 and put the public host:port here:
#   ngrok tcp 5432   ->  AEROSEARCH_TUNNEL_PG=0.tcp.ngrok.io:17284
#   ngrok tcp 9000   ->  AEROSEARCH_TUNNEL_S3=0.tcp.ngrok.io:19112
# With Tailscale, use the tailnet IP and the normal ports.
# Without these the DAG fails its first task with instructions, rather than
# spending a GPU session to discover the tunnel is down.
#AEROSEARCH_TUNNEL_PG=
#AEROSEARCH_TUNNEL_S3=

# Pool credentials: one directory per account holding a `token` file. Mounted
# read-only into the Airflow containers. See gpu_pool/README.md.
#KAGGLE_TOKENS_DIR=~/pool_tokens

# Preferred pool account (the launcher falls back when it is at its 2-session
# cap), accelerator, rows per run, and the schedule.
#AEROSEARCH_KAGGLE_ACCOUNT=account8_PepeSchneyne
#AEROSEARCH_KAGGLE_ACCELERATOR=t4
#AEROSEARCH_BATCH_LIMIT=200
#AEROSEARCH_SCHEDULE=*/15 * * * *

# Embedding contract. "gemma2" (default, multimodal, 768-dim) or "e5" (text-only,
# 1024-dim). These are DIFFERENT vector spaces: switching needs a full re-embed.
# See aerosearch/pinned.py.
#AEROSEARCH_EMBED_BACKEND=gemma2

# --- Airflow ---------------------------------------------------------------
# Encrypts connection/variable secrets in Airflow's metadata DB. Generate your
# own; never reuse a key from a public repo:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#AIRFLOW_FERNET_KEY=
