# Copy to .env and fill in.  `docker compose` and the local venv both read this.

# --- Telegram ---
API_KEY=123456:your-telegram-bot-token-from-BotFather

# --- MinIO (blob storage for media) ---
# For MinIO the root user/password ARE the access/secret keys, so keep them equal.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=media
# Endpoint the *containers* use (bot/airflow). Local venv runs override to localhost:9000.
MINIO_ENDPOINT=minio:9000

# --- Postgres + pgvector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aerosearch
# DATABASE_URL is what containers use; LOCAL_DATABASE_URL is for venv runs on the host.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aerosearch
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aerosearch

# --- Airflow ---
# Encrypts connection/variable secrets in Airflow's metadata DB. Generate your own —
# never reuse a key from a public repo, or anyone can decrypt that DB:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=admin

# --- Models (optional overrides) ---
# Gemma is gated on Hugging Face — needed by the Airflow batch worker.
HF_TOKEN=
# CPU batch default; use google/gemma-3-4b-it on a GPU.
AEROSEARCH_CAPTION_MODEL=google/gemma-3n-E2B-it
AEROSEARCH_WHISPER_MODEL=small
